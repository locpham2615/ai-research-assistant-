# App
APP_ENV=development
LOG_LEVEL=INFO

# Local LLM (llama-server OpenAI-compatible API)
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen3-4b-instruct
LOCAL_LLM_TIMEOUT_SEC=45

# Cloud LLM (OpenRouter / Google AI Studio / Groq)
CLOUD_LLM_BASE_URL=https://openrouter.ai/api/v1
CLOUD_LLM_API_KEY=your_api_key_here
CLOUD_LLM_MODEL=google/gemini-2.5-flash
CLOUD_LLM_TIMEOUT_SEC=30

# Storage
SQLITE_DB_PATH=data/research_assistant.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=research_papers